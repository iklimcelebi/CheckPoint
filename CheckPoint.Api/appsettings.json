{
  "Jwt": {
    "Issuer": "CheckPoint.Api",
    "Audience": "CheckPoint.Client",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxFileSizeMB": 20
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Database": {
    "AutoMigrate": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
