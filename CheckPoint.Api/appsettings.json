{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CheckPointDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "CheckPoint.Api",
    "Audience": "CheckPoint.Client",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxFileSizeMB": 20
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}