{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CheckPointDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "CheckPoint.Api",
    "Audience": "CheckPoint.Client",
    "ExpiryMinutes": 60
  },
  "FileStorage": {
    "RootPath": "uploads",
    "MaxFileSizeMB": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}